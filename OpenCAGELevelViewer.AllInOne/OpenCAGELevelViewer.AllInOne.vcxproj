  <!-- Configuration-Independent -->
  <PropertyGroup>
    <!-- MSBuild -->
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{9f4b18f5-cfa9-43fd-bdc5-17ff9476a6c1}</ProjectGuid>
    <RootNamespace>OpenCAGELevelViewerAllInOne</RootNamespace>
    <!-- MSBuild and VC++ Versions -->
    <VCProjectVersion>17.0</VCProjectVersion>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformMinVersion>
    <VCToolsVersion />
    <PlatformToolset>v145</PlatformToolset>
    <!-- CLR -->
    <ManagedAssembly>true</ManagedAssembly>
    <CLRSupport>NetCore</CLRSupport>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Win32 -->
    <CharacterSet>Unicode</CharacterSet>
    <!-- Compilation Settings -->
    <EnableUnitySupport>false</EnableUnitySupport>
    <UseOfMfc>false</UseOfMfc>
    <!-- Code Analysis-->
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <EnableClangTidyCodeAnalysis>false</EnableClangTidyCodeAnalysis>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <ClangTidyChecks>!c++98-compat-pedantic</ClangTidyChecks>
    <!-- Output -->
    <CopyLocalDeploymentContent>true</CopyLocalDeploymentContent>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- C# Dependencies -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableManagedPackageReferenceSupport>true</EnableManagedPackageReferenceSupport>
    <!-- VCPkg -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgXUseBuiltInApplocalDeps>true</VcpkgXUseBuiltInApplocalDeps>
    <VcpkgAutoLink>true</VcpkgAutoLink>
    <VcpkgUseStatic>false</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>OpenCAGELevelViewer_AllInOne_EXPORTS;OPENCAGELEVELVIEWER_ALLINONE_EXPORTS;WIN32;OPENCAGELEVELVIEWERALLINONE_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\..\ExtMSBuildImports;$(ProtobufCompiledDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!--<PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>-->
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdclatest</LanguageStandard_C>
      <EnablePREfast>true</EnablePREfast>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <ShowProgress>LinkVerbose</ShowProgress>
    </Link>
  </ItemDefinitionGroup>
  <!-- Sanitised Configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Sanitised'">
    <EnableASAN>true</EnableASAN>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Sanitised'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
